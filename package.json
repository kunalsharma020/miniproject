{
  "name": "configuration-management-system-with-validation",
  "version": "1.0.0",
  "description": "Configuration Management System with Validation (Express + MongoDB + AJV)",
  "main": "src/server.js",
  "type": "commonjs",
  "scripts": {
    "dev": "nodemon src/server.js",
    "start": "node src/server.js",
    "lint": "node -c src/server.js",
    "seed": "node scripts/seed-schemas.js",
